 // 5
 int[] array = { 2, 3, 5, 7, 8, 11 };
 int hasil = 0;

 // "Ambil setiap 'angka' di dalam 'array'"
 foreach (int angka in array)
 {
     // Cek apakah 'angka' tersebut genap
     if (angka % 2 == 0)
     {
         hasil += angka; // Tambahkan langsung angkanya
     }
 }

 Console.WriteLine(hasil);


