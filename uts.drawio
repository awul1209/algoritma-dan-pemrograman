        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam defaultTextAlignment center\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\n\nstart\n:Pengguna Memilih Menu 3;\n\nif (Total Belanja == 0?) then (Ya)\n  :Tampilkan Pesan\\n\&quot;Keranjang Belanja Masih Kosong\&quot;;\n  stop\nelse (Tidak)\n  :Tampilkan Struk Pembelian &amp; Total Belanja;\n\n  if (Total &gt;= 150.000?) then (Ya)\n    :Berikan Diskon 15%;\n  else if (Total &gt;= 75.000?) then (Ya)\n    :Berikan Diskon 5%;\n  else (Tidak)\n    :Diskon = 0%;\n  endif\n\n  :Hitung Total Akhir Setelah Diskon;\n\n  repeat\n    :Input Uang Tunai Pembeli;\n    if (Uang Bayar &gt;= Total Akhir?) then (Ya)\n      :Hitung Uang Kembalian;\\nTampilkan Pesan \&quot;Terima Kasih\&quot;;\\nReset Total Belanja &amp; Riwayat;\n      :pembayaranValid = true;\n    else (Tidak)\n      :Tampilkan Pesan\\n\&quot;Uang Tunai Kurang!\&quot;;\n      :pembayaranValid = false;\n    endif\n  repeat while (pembayaranValid == false?) is (Uang Kurang)\n\n  :Tunggu Input Pengguna (Tekan Tombol Apapun);\n  stop\nendif\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="o_Sk_8efkewMsvPZXg0c-348">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
