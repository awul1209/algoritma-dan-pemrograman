        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam monochrome true\nskinparam defaultTextAlignment center\nskinparam ActivityBackgroundColor white\nskinparam ActivityBorderColor black\n\nstart\n:Mulai Program Kasir;\n:Inisialisasi Data Barang &amp; Stok;\n\nrepeat\n  :Tampilkan Menu Utama\\n(1. Lihat Barang\\n2. Beli Barang\\n3. Bayar &amp; Struk\\n4. Keluar);\n  :Input Pilihan Menu;\n\n  switch (Pilihan Menu)\n    case ( == 1 )\n      :Proses Menu 1\\n(Lihat Daftar Barang);\n    case ( == 2 )\n      :Proses Menu 2\\n(Transaksi Pembelian);\n    case ( == 3 )\n      :Proses Menu 3\\n(Pembayaran &amp; Cetak Struk);\n    case ( == 4 )\n      :Selesai / Keluar Program;\n      detach\n    case ( Lainnya )\n      :Tampilkan Pesan Tidak Valid;\n  endswitch\n\nrepeat while (Keluar Program?) is (Tidak)\n\nstop\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="o_Sk_8efkewMsvPZXg0c-416">
